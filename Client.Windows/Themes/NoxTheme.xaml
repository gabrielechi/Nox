    <!-- A 24x24 stroked icon. Wrap it in a Viewbox to size it. -->
    <Style x:Key="NoxIconPath" TargetType="Path">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Stroke" Value="{StaticResource NoxTextMutedBrush}"/>
        <Setter Property="StrokeThickness" Value="2"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="SnapsToDevicePixels" Value="False"/>
    </Style>

    <!-- ===== Text styles ===== -->
    <Style x:Key="NoxTitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource NoxFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource NoxTitleFontSize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource NoxTextBrush}"/>
    </Style>
    <Style x:Key="NoxSectionTitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource NoxFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource NoxSectionFontSize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource NoxTextBrush}"/>
    </Style>
    <Style x:Key="NoxLabelText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource NoxFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource NoxLabelFontSize}"/>
        <Setter Property="Foreground" Value="{StaticResource NoxTextMutedBrush}"/>
    </Style>
    <Style x:Key="NoxMonoText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource NoxMonoFontFamily}"/>
        <Setter Property="Foreground" Value="{StaticResource NoxTextBrush}"/>
    </Style>

    <!-- Numbered step badge (decorative). -->
    <Style x:Key="NoxStepBadge" TargetType="Border">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Background" Value="{StaticResource NoxAccentBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource NoxAccentForegroundBrush}"/>
        <Setter Property="TextElement.FontSize" Value="12"/>
        <Setter Property="TextElement.FontWeight" Value="Bold"/>
    </Style>

    <!-- ===== Keyboard focus ring (shown only for keyboard navigation) ===== -->
    <Style x:Key="NoxFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="13" BorderThickness="2" SnapsToDevicePixels="True"
                            BorderBrush="{StaticResource NoxAccentBrush}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Window (dialogs created in code-behind) ===== -->
    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="{StaticResource NoxFontFamily}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <!-- ===== Buttons ===== -->
    <!-- Default (secondary) button: raised surface, thin border. -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource NoxRaisedBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource NoxTextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource NoxBorderStrongBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FontFamily" Value="{StaticResource NoxFontFamily}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource NoxFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root">
                        <Border x:Name="Surface" CornerRadius="10" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                        <Border x:Name="HoverLayer" CornerRadius="10" Background="#FFFFFFFF" Opacity="0"/>
                        <Border x:Name="PressLayer" CornerRadius="10" Background="#FF000000" Opacity="0"/>
                        <ContentPresenter x:Name="ContentHost" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0.06" Duration="0:0:0.15"/>
                            </Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                            </Storyboard></BeginStoryboard></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="PressLayer" Storyboard.TargetProperty="Opacity" To="0.18" Duration="0:0:0.08"/>
                            </Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="PressLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                            </Storyboard></BeginStoryboard></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                        </Trigger>
                        <!-- Dialogs built in code paint primary buttons with PrimaryBrush and white text:
                             keep the accent readable by drawing dark text on it. -->
                        <DataTrigger Binding="{Binding Background.Color, RelativeSource={RelativeSource Self}}" Value="#FF4ADE9A">
                            <Setter TargetName="ContentHost" Property="TextElement.Foreground" Value="{StaticResource NoxAccentForegroundBrush}"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary button: always drawn in the accent, whatever colours code-behind assigns;
         the enabled/disabled state alone decides the look. -->
    <ControlTemplate x:Key="NoxPrimaryButtonTemplate" TargetType="Button">
        <Grid x:Name="Root">
            <Border x:Name="Surface" CornerRadius="10" Background="{StaticResource NoxAccentBrush}"
                    BorderBrush="Transparent" BorderThickness="1"/>
            <Border x:Name="HoverLayer" CornerRadius="10" Background="#FFFFFFFF" Opacity="0"/>
            <Border x:Name="PressLayer" CornerRadius="10" Background="#FF000000" Opacity="0"/>
            <ContentPresenter x:Name="ContentHost" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              TextElement.Foreground="{StaticResource NoxAccentForegroundBrush}"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0.14" Duration="0:0:0.15"/>
                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                </Storyboard></BeginStoryboard></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                    <DoubleAnimation Storyboard.TargetName="PressLayer" Storyboard.TargetProperty="Opacity" To="0.16" Duration="0:0:0.08"/>
                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                    <DoubleAnimation Storyboard.TargetName="PressLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                </Storyboard></BeginStoryboard></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Surface" Property="Background" Value="{StaticResource NoxRaisedBrush}"/>
                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource NoxBorderBrush}"/>
                <Setter TargetName="ContentHost" Property="TextElement.Foreground" Value="{StaticResource NoxTextDisabledBrush}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Same as the primary template, with a lock glyph before the label (encrypted send). -->
    <ControlTemplate x:Key="NoxPrimaryLockButtonTemplate" TargetType="Button">
        <Grid x:Name="Root">
            <Border x:Name="Surface" CornerRadius="10" Background="{StaticResource NoxAccentBrush}"
                    BorderBrush="Transparent" BorderThickness="1"/>
            <Border x:Name="HoverLayer" CornerRadius="10" Background="#FFFFFFFF" Opacity="0"/>
            <Border x:Name="PressLayer" CornerRadius="10" Background="#FF000000" Opacity="0"/>
            <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                <Viewbox Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Path x:Name="LockIcon" Style="{StaticResource NoxIconPath}" Data="{StaticResource NoxIconLock}"
                          StrokeThickness="2.2" Stroke="{StaticResource NoxAccentForegroundBrush}"/>
                </Viewbox>
                <ContentPresenter x:Name="ContentHost" RecognizesAccessKey="True" VerticalAlignment="Center"
                                  TextElement.Foreground="{StaticResource NoxAccentForegroundBrush}"/>
            </StackPanel>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0.14" Duration="0:0:0.15"/>
                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                </Storyboard></BeginStoryboard></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                    <DoubleAnimation Storyboard.TargetName="PressLayer" Storyboard.TargetProperty="Opacity" To="0.16" Duration="0:0:0.08"/>
                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                    <DoubleAnimation Storyboard.TargetName="PressLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                </Storyboard></BeginStoryboard></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Surface" Property="Background" Value="{StaticResource NoxRaisedBrush}"/>
                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource NoxBorderBrush}"/>
                <Setter TargetName="ContentHost" Property="TextElement.Foreground" Value="{StaticResource NoxTextDisabledBrush}"/>
                <Setter TargetName="LockIcon" Property="Stroke" Value="{StaticResource NoxTextDisabledBrush}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Height" Value="46"/>
        <Setter Property="Padding" Value="20,0"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Template" Value="{StaticResource NoxPrimaryButtonTemplate}"/>
    </Style>

    <Style x:Key="NoxPrimaryLockButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="Template" Value="{StaticResource NoxPrimaryLockButtonTemplate}"/>
    </Style>

    <!-- Transparent square button hosting a Path icon. -->
    <Style x:Key="NoxIconButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource NoxTextMutedBrush}"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="0"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource NoxTextBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Text-only link-like button. -->
    <Style x:Key="NoxLinkButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource NoxTextMutedBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontFamily" Value="{StaticResource NoxFontFamily}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource NoxFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="ContentHost" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ContentHost" Property="TextElement.Foreground" Value="{StaticResource NoxAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SidebarButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{StaticResource NoxTextMutedBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>

    <!-- ===== Cards / panels ===== -->
    <Style x:Key="PanelBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource NoxCardRadius}"/>
        <Setter Property="Padding" Value="20"/>
    </Style>

    <Style x:Key="AuthCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource NoxLargeRadius}"/>
        <Setter Property="Padding" Value="24"/>
    </Style>

    <Style x:Key="StatusLine" TargetType="TextBlock">
        <Style.Triggers>
            <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Text inputs ===== -->
    <Style TargetType="TextBox">
        <Setter Property="Height" Value="46"/>
        <Setter Property="FontFamily" Value="{StaticResource NoxFontFamily}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="{StaticResource NoxCardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource NoxBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource NoxAccentBrush}"/>
        <Setter Property="SelectionOpacity" Value="0.35"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid x:Name="Root">
                        <Border x:Name="Field" CornerRadius="10" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                        <Border x:Name="HoverBorder" CornerRadius="10" BorderThickness="1" Opacity="0" IsHitTestVisible="False"
                                BorderBrush="{StaticResource NoxBorderStrongBrush}"/>
                        <Border x:Name="FocusBorder" CornerRadius="10" BorderThickness="1.5" Opacity="0" IsHitTestVisible="False"
                                BorderBrush="{StaticResource NoxAccentBrush}"/>
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="HoverBorder" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                            </Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="HoverBorder" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                            </Storyboard></BeginStoryboard></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="FocusBorder" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                            </Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="FocusBorder" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                            </Storyboard></BeginStoryboard></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Height" Value="46"/>
        <Setter Property="FontFamily" Value="{StaticResource NoxFontFamily}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="{StaticResource NoxCardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource NoxBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource NoxAccentBrush}"/>
        <Setter Property="SelectionOpacity" Value="0.35"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Grid x:Name="Root">
                        <Border x:Name="Field" CornerRadius="10" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                        <Border x:Name="HoverBorder" CornerRadius="10" BorderThickness="1" Opacity="0" IsHitTestVisible="False"
                                BorderBrush="{StaticResource NoxBorderStrongBrush}"/>
                        <Border x:Name="FocusBorder" CornerRadius="10" BorderThickness="1.5" Opacity="0" IsHitTestVisible="False"
                                BorderBrush="{StaticResource NoxAccentBrush}"/>
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="HoverBorder" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                            </Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="HoverBorder" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                            </Storyboard></BeginStoryboard></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="FocusBorder" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                            </Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="FocusBorder" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                            </Storyboard></BeginStoryboard></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== CheckBox / RadioButton ===== -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource NoxTextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource NoxFontFamily}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource NoxFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid x:Name="Root" Background="Transparent">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Grid Width="20" Height="20" VerticalAlignment="Center">
                            <Border x:Name="Box" CornerRadius="6" BorderThickness="1.5"
                                    BorderBrush="{StaticResource NoxBorderStrongBrush}" Background="{StaticResource NoxCardBrush}"/>
                            <Border x:Name="CheckFill" CornerRadius="6" Opacity="0" Background="{StaticResource NoxAccentBrush}"/>
                            <Path x:Name="CheckMark" Data="M5.5,10.5 L8.6,13.5 L14.5,7" Opacity="0"
                                  Stroke="{StaticResource NoxAccentForegroundBrush}" StrokeThickness="2.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Grid>
                        <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource NoxTextMutedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckFill" Property="Opacity" Value="1"/>
                            <Setter TargetName="CheckMark" Property="Opacity" Value="1"/>
                            <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="CheckFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetName="CheckMark" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                            </Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="CheckFill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetName="CheckMark" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                            </Storyboard></BeginStoryboard></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource NoxTextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource NoxFontFamily}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource NoxFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="Root" Background="Transparent">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Grid Width="20" Height="20" VerticalAlignment="Center">
                            <Ellipse x:Name="Ring" StrokeThickness="1.5"
                                     Stroke="{StaticResource NoxBorderStrongBrush}" Fill="{StaticResource NoxCardBrush}"/>
                            <Ellipse x:Name="Dot" Width="10" Height="10" Opacity="0" Fill="{StaticResource NoxAccentBrush}"/>
                        </Grid>
                        <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource NoxTextMutedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource NoxAccentBrush}"/>
                            <Setter TargetName="Dot" Property="Opacity" Value="1"/>
                            <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                            </Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                            </Storyboard></BeginStoryboard></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== ComboBox ===== -->
    <ControlTemplate x:Key="NoxComboBoxToggleTemplate" TargetType="ToggleButton">
        <Grid>
            <Border x:Name="Surface" CornerRadius="10" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
            <Border x:Name="HoverLayer" CornerRadius="10" Background="#FFFFFFFF" Opacity="0"/>
            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0.05" Duration="0:0:0.15"/>
                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                </Storyboard></BeginStoryboard></Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="NoxComboBoxTemplate" TargetType="ComboBox">
        <Grid x:Name="Root" SnapsToDevicePixels="True">
            <ToggleButton Focusable="False" ClickMode="Press" Template="{StaticResource NoxComboBoxToggleTemplate}"
                          Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
            <Grid Margin="{TemplateBinding Padding}" IsHitTestVisible="False">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="Center"
                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                <Viewbox x:Name="Chevron" Grid.Column="1" Width="14" Height="14" Margin="6,0,0,0"
                         VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <Path Style="{StaticResource NoxIconPath}" Data="{StaticResource NoxIconChevronDown}" StrokeThickness="2.2"/>
                </Viewbox>
            </Grid>
            <Border x:Name="FocusBorder" CornerRadius="10" BorderThickness="1.5" Opacity="0" IsHitTestVisible="False"
                    BorderBrush="{StaticResource NoxAccentBrush}"/>
            <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="4" AllowsTransparency="True" Focusable="False"
                   PopupAnimation="Fade" IsOpen="{TemplateBinding IsDropDownOpen}">
                <Border MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                        Background="{StaticResource NoxRaisedBrush}" BorderBrush="{StaticResource NoxBorderStrongBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="4">
                    <ScrollViewer CanContentScroll="True">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                    </ScrollViewer>
                </Border>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="FocusBorder" Property="Opacity" Value="1"/>
            </Trigger>
            <Trigger Property="IsDropDownOpen" Value="True">
                <Setter TargetName="FocusBorder" Property="Opacity" Value="1"/>
                <Setter TargetName="Chevron" Property="RenderTransform">
                    <Setter.Value><RotateTransform Angle="180"/></Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource NoxCardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource NoxBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource NoxTextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource NoxFontFamily}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="14,0,12,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template" Value="{StaticResource NoxComboBoxTemplate}"/>
    </Style>

    <!-- Kept for the existing XAML references. -->
    <Style x:Key="SelectorStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"/>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource NoxTextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Grid x:Name="Root" Background="Transparent">
                        <Border x:Name="Highlight" CornerRadius="8" Opacity="0" Background="{StaticResource NoxRaisedHoverBrush}"/>
                        <Border x:Name="Selection" CornerRadius="8" Opacity="0" Background="{StaticResource NoxAccentSubtleBrush}"/>
                        <DockPanel Margin="{TemplateBinding Padding}">
                            <Viewbox x:Name="CheckGlyph" DockPanel.Dock="Right" Width="14" Height="14" Margin="12,0,0,0" Visibility="Collapsed">
                                <Path Style="{StaticResource NoxIconPath}" Data="{StaticResource NoxIconCheck}"
                                      StrokeThickness="2.5" Stroke="{StaticResource NoxAccentBrush}"/>
                            </Viewbox>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </DockPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Selection" Property="Opacity" Value="1"/>
                            <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Highlight" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== ListBox: items are cards, the selected one has an accent border ===== -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource NoxBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource NoxTextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource NoxFontFamily}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" SnapsToDevicePixels="True">
                        <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}"
                                      CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                      HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </ScrollViewer>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource NoxTextBrush}"/>
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource NoxFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid x:Name="Root">
                        <Border x:Name="Card" CornerRadius="12" BorderThickness="1"
                                Background="{StaticResource NoxCardBrush}" BorderBrush="{StaticResource NoxBorderBrush}"/>
                        <Border x:Name="HoverCard" CornerRadius="12" BorderThickness="1" Opacity="0"
                                Background="{StaticResource NoxCardHoverBrush}" BorderBrush="{StaticResource NoxBorderStrongBrush}"/>
                        <Border x:Name="SelectedCard" CornerRadius="12" BorderThickness="1.5" Opacity="0"
                                Background="{StaticResource NoxAccentSubtleBrush}" BorderBrush="{StaticResource NoxAccentBrush}"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="HoverCard" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                            </Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="HoverCard" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                            </Storyboard></BeginStoryboard></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="SelectedCard" Property="Opacity" Value="1"/>
                            <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="SelectedCard" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                            </Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="SelectedCard" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                            </Storyboard></BeginStoryboard></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== ScrollBar: thin rounded thumb, transparent track ===== -->
    <Style x:Key="NoxScrollBarPageButton" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NoxScrollBarThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbSurface" CornerRadius="3" Margin="{TemplateBinding Padding}"
                            Background="{StaticResource NoxBorderStrongBrush}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbSurface" Property="Background" Value="{StaticResource NoxTextDisabledBrush}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbSurface" Property="Background" Value="{StaticResource NoxTextMutedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
        <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="10"/>
                <Setter Property="MinHeight" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track" Orientation="Horizontal">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource NoxScrollBarPageButton}" Command="ScrollBar.PageLeftCommand"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource NoxScrollBarThumb}" Padding="0,2" MinWidth="24"/>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource NoxScrollBarPageButton}" Command="ScrollBar.PageRightCommand"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="10"/>
                <Setter Property="MinWidth" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource NoxScrollBarPageButton}" Command="ScrollBar.PageUpCommand"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource NoxScrollBarThumb}" Padding="2,0" MinHeight="24"/>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource NoxScrollBarPageButton}" Command="ScrollBar.PageDownCommand"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== ProgressBar ===== -->
    <Style TargetType="ProgressBar">
        <Setter Property="Background" Value="{StaticResource NoxRaisedBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource NoxAccentBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="PART_Track" CornerRadius="4" Background="{TemplateBinding Background}"/>
                        <Border x:Name="PART_Indicator" CornerRadius="4" HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Sidebar navigation (Develop2 layout) ===== -->
    <Geometry x:Key="NoxIconArrowUp">M12,19 V5 M5,12 L12,5 L19,12</Geometry>
    <Geometry x:Key="NoxIconArrowDown">M12,5 V19 M5,12 L12,19 L19,12</Geometry>
    <Geometry x:Key="NoxIconShield">M20,13 C20,18 16.5,20.5 12.34,21.95 A1,1 0 0 1 11.67,21.94 C7.5,20.5 4,18 4,13 V6 A1,1 0 0 1 5,5 C7,5 9.5,3.8 11.24,2.28 A1.17,1.17 0 0 1 12.76,2.28 C14.51,3.81 17,5 19,5 A1,1 0 0 1 20,6 Z M9,12 L11,14 L15,10</Geometry>
    <Geometry x:Key="NoxIconUsers">M5.5,8 A3.5,3.5 0 1 0 12.5,8 A3.5,3.5 0 1 0 5.5,8 Z M2.5,20 A6.5,6.5 0 0 1 15.5,20 M16,4.5 A3.5,3.5 0 0 1 16,11.5 M18,14 A6,6 0 0 1 21.5,20</Geometry>

    <!-- Icon of a sidebar item: muted, accent when its TabItem is selected. -->
    <Style x:Key="NoxNavIconPath" TargetType="Path" BasedOn="{StaticResource NoxIconPath}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TabItem}}" Value="True">
                <Setter Property="Stroke" Value="{StaticResource NoxAccentBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Thin horizontal separator used inside cards. -->
    <Style x:Key="NoxDivider" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="0,16"/>
        <Setter Property="Background" Value="{StaticResource NoxBorderBrush}"/>
    </Style>

    <!-- Side card (summary / settings column). -->
    <Style x:Key="NoxSideCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource NoxCardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource NoxBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource NoxLargeRadius}"/>
        <Setter Property="Padding" Value="22"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>

    <!-- Recipient "edit" button: amber surface with a pencil, shown after a successful check. -->
    <ControlTemplate x:Key="NoxEditButtonTemplate" TargetType="Button">
        <Grid x:Name="Root">
            <Border x:Name="Surface" CornerRadius="10" Background="{StaticResource NoxWarningBrush}"/>
            <Border x:Name="HoverLayer" CornerRadius="10" Background="#FFFFFFFF" Opacity="0"/>
            <Border x:Name="PressLayer" CornerRadius="10" Background="#FF000000" Opacity="0"/>
            <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Path Style="{StaticResource NoxIconPath}" Data="{StaticResource NoxIconEdit}" StrokeThickness="2.2"
                      Stroke="{StaticResource NoxAccentForegroundBrush}"/>
            </Viewbox>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0.16" Duration="0:0:0.15"/>
                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                </Storyboard></BeginStoryboard></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                    <DoubleAnimation Storyboard.TargetName="PressLayer" Storyboard.TargetProperty="Opacity" To="0.16" Duration="0:0:0.08"/>
                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                    <DoubleAnimation Storyboard.TargetName="PressLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                </Storyboard></BeginStoryboard></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- ===== ToolTip ===== -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource NoxTextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource NoxFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="MaxWidth" Value="360"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{StaticResource NoxRaisedBrush}" BorderBrush="{StaticResource NoxBorderStrongBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="10,6">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
