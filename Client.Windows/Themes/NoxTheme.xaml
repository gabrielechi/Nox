<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ===================================================================
         NOX THEME — dark, clean, single mint accent.
         Only visual resources live here: colours, brushes, typography,
         geometry for icons and control styles/templates.
         The legacy keys (AppBackgroundBrush, PanelBackgroundBrush,
         BorderBrush, PrimaryBrush, AccentBrush, TextPrimaryBrush,
         TextMutedBrush, ...) are kept because code-behind looks them up
         with FindResource.
         =================================================================== -->

    <!-- ===== Palette ===== -->
    <Color x:Key="NoxWindowColor">#0E1116</Color>
    <Color x:Key="NoxSidebarColor">#12171D</Color>
    <Color x:Key="NoxCardColor">#151A21</Color>
    <Color x:Key="NoxCardHoverColor">#1A2028</Color>
    <Color x:Key="NoxRaisedColor">#1E2630</Color>
    <Color x:Key="NoxRaisedHoverColor">#252E3A</Color>
    <Color x:Key="NoxBorderColor">#2A323D</Color>
    <Color x:Key="NoxBorderStrongColor">#3A4553</Color>
    <Color x:Key="NoxTextColor">#E8ECF2</Color>
    <Color x:Key="NoxTextMutedColor">#9AA4B2</Color>
    <Color x:Key="NoxTextDisabledColor">#5C6673</Color>
    <Color x:Key="NoxAccentColor">#4ADE9A</Color>
    <Color x:Key="NoxAccentForegroundColor">#07130D</Color>
    <Color x:Key="NoxAccentSubtleColor">#17211F</Color>
    <Color x:Key="NoxAccentMutedColor">#26453A</Color>
    <Color x:Key="NoxWarningColor">#F5B94A</Color>
    <Color x:Key="NoxDangerColor">#C42B1C</Color>

    <SolidColorBrush x:Key="NoxWindowBrush" Color="{StaticResource NoxWindowColor}"/>
    <SolidColorBrush x:Key="NoxSidebarBrush" Color="{StaticResource NoxSidebarColor}"/>
    <SolidColorBrush x:Key="NoxCardBrush" Color="{StaticResource NoxCardColor}"/>
    <SolidColorBrush x:Key="NoxCardHoverBrush" Color="{StaticResource NoxCardHoverColor}"/>
    <SolidColorBrush x:Key="NoxRaisedBrush" Color="{StaticResource NoxRaisedColor}"/>
    <SolidColorBrush x:Key="NoxRaisedHoverBrush" Color="{StaticResource NoxRaisedHoverColor}"/>
    <SolidColorBrush x:Key="NoxBorderBrush" Color="{StaticResource NoxBorderColor}"/>
    <SolidColorBrush x:Key="NoxBorderStrongBrush" Color="{StaticResource NoxBorderStrongColor}"/>
    <SolidColorBrush x:Key="NoxTextBrush" Color="{StaticResource NoxTextColor}"/>
    <SolidColorBrush x:Key="NoxTextMutedBrush" Color="{StaticResource NoxTextMutedColor}"/>
    <SolidColorBrush x:Key="NoxTextDisabledBrush" Color="{StaticResource NoxTextDisabledColor}"/>
    <SolidColorBrush x:Key="NoxAccentBrush" Color="{StaticResource NoxAccentColor}"/>
    <SolidColorBrush x:Key="NoxAccentForegroundBrush" Color="{StaticResource NoxAccentForegroundColor}"/>
    <SolidColorBrush x:Key="NoxAccentSubtleBrush" Color="{StaticResource NoxAccentSubtleColor}"/>
    <SolidColorBrush x:Key="NoxAccentMutedBrush" Color="{StaticResource NoxAccentMutedColor}"/>
    <SolidColorBrush x:Key="NoxWarningBrush" Color="{StaticResource NoxWarningColor}"/>
    <SolidColorBrush x:Key="NoxDangerBrush" Color="{StaticResource NoxDangerColor}"/>
    <SolidColorBrush x:Key="NoxSelectionBrush" Color="{StaticResource NoxAccentColor}" Opacity=".35"/>

    <!-- ===== Legacy keys (used by XAML and by code-behind FindResource) ===== -->
    <Color x:Key="AppBackgroundColor">#0E1116</Color>
    <Color x:Key="SidebarBackgroundColor">#12171D</Color>
    <Color x:Key="PanelBackgroundColor">#151A21</Color>
    <Color x:Key="BorderColor">#2A323D</Color>
    <Color x:Key="PrimaryColor">#4ADE9A</Color>
    <Color x:Key="TextPrimaryColor">#E8ECF2</Color>
    <Color x:Key="TextMutedColor">#9AA4B2</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarBackgroundColor}"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{StaticResource PanelBackgroundColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource NoxAccentColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>

    <!-- ===== Typography ===== -->
    <FontFamily x:Key="NoxFontFamily">Inter, Segoe UI</FontFamily>
    <FontFamily x:Key="NoxMonoFontFamily">Consolas</FontFamily>
    <sys:Double x:Key="NoxTitleFontSize">28</sys:Double>
    <sys:Double x:Key="NoxSectionFontSize">16</sys:Double>
    <sys:Double x:Key="NoxBodyFontSize">14</sys:Double>
    <sys:Double x:Key="NoxLabelFontSize">12</sys:Double>

    <!-- ===== Shape ===== -->
    <CornerRadius x:Key="NoxControlRadius">10</CornerRadius>
    <CornerRadius x:Key="NoxCardRadius">14</CornerRadius>
    <CornerRadius x:Key="NoxLargeRadius">16</CornerRadius>

