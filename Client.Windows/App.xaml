<Application x:Class="Client.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Wpf.Ui;component/Resources/Fonts.xaml"/>
                <!-- Colours, typography, icons and control templates of the Nox dark theme. -->
                <ResourceDictionary Source="Themes/NoxTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <sys:Double x:Key="DefaultIconFontSize">20</sys:Double>
        </ResourceDictionary>
    </Application.Resources>
</Application>
