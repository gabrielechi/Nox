<Window x:Class="Client.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Title="{DynamicResource NoxText.EndToEndEncryptedFileTransfer}"
        Icon="Assets/NoxWindows.ico"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="SelectorStyle" TargetType="ComboBox">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
                                        <Grid>
                                            <ToggleButton Focusable="False" ClickMode="Press"
                                                          IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border Background="#121722" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                                <StackPanel Orientation="Horizontal">
                                                    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" TextElement.Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <ui:SymbolIcon Symbol="ChevronDown16" FontSize="13" Margin="4,0,0,0" Foreground="{StaticResource AccentBrush}"/>
                                                </StackPanel>
                                            </ToggleButton>
                                            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True">
                                                <Border MinWidth="{TemplateBinding ActualWidth}" Padding="2" Background="{StaticResource PanelBackgroundBrush}"
                                                        BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" CornerRadius="5">
                                                    <ItemsPresenter/>
                                                </Border>
                                            </Popup>
                                        </Grid>
                                    </ControlTemplate></Setter.Value></Setter>
            <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem">
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                    <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}"/>
                                    <Setter Property="Padding" Value="6,4"/>
                                </Style></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="0" GlassFrameThickness="0"
                      CornerRadius="6" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <DockPanel>
        <DockPanel.Style>
            <Style TargetType="DockPanel">
                <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Visibility, ElementName=AuthScreen}" Value="Visible">
                        <Setter Property="Background">
                            <Setter.Value>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#28223D"/><GradientStop Color="#121722" Offset=".75"/>
                                </LinearGradientBrush>
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </DockPanel.Style>
        <Grid DockPanel.Dock="Top" Height="34" Background="Transparent">
            <Grid.Resources>
                <Style x:Key="CaptionAction" TargetType="Button">
                    <Setter Property="Width" Value="44"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                    <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#353646"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="#45465A"/></Trigger>
                    </Style.Triggers>
                </Style>
            </Grid.Resources>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                       Visibility="{Binding Visibility, ElementName=MainShell}"
                       VerticalAlignment="Center" Margin="12,0" FontSize="12" TextTrimming="CharacterEllipsis"
                       Foreground="{StaticResource TextMutedBrush}"/>
            <Button x:Name="MinimizeWindowButton" Grid.Column="1" Style="{StaticResource CaptionAction}"
                    ToolTip="{DynamicResource NoxText.Minimize}" AutomationProperties.Name="{DynamicResource NoxText.Minimize}" Click="MinimizeWindow_Click">
                <Path Data="M0,0 L10,0" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"/>
            </Button>
            <Button x:Name="CloseWindowButton" Grid.Column="2" ToolTip="{DynamicResource NoxText.Close}" AutomationProperties.Name="{DynamicResource NoxText.Close}" Click="CloseWindow_Click">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource CaptionAction}">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#B33145"/></Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"/>
            </Button>
        </Grid>
    <Grid x:Name="AppRoot">

        <!-- AUTH SCREEN -->
        <Grid x:Name="AuthScreen"
              Visibility="Visible"
              Margin="0">
            <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
            <StackPanel Width="416">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,18">
                <Image Source="Assets/NoxLogo.ico" Width="60" Height="60"/>
                <TextBlock Text="NOX" VerticalAlignment="Center" FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="32" FontWeight="Bold" Margin="10,0,0,0" Foreground="{StaticResource TextPrimaryBrush}"/>
            </StackPanel>
            <Grid Margin="20,0">
                <Border Style="{StaticResource AuthCardStyle}" MaxWidth="408"
                        Background="{StaticResource PanelBackgroundBrush}" Padding="20" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource NoxText.SignInAlt}" FontSize="28" FontWeight="SemiBold"
                                   Margin="0,4,0,20" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource NoxText.ServerURL}"
                                       FontSize="16"
                                       Foreground="{StaticResource TextMutedBrush}" />
                            <Ellipse x:Name="ServerOnlineIndicator"
                                     Width="9"
                                     Height="9"
                                     Margin="8,2,0,0"
                                     Fill="#FF5C5C"
                                     Visibility="Visible" />
                            <TextBlock x:Name="ServerStatusLabel" Text="{DynamicResource NoxText.NotConnected}" FontSize="14" Margin="6,0,0,0"
                                       VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                        <Grid Margin="0,6,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="ServerSchemeBox" Style="{StaticResource SelectorStyle}" SelectedIndex="0" Margin="0,0,6,0" Height="46"
                                      VerticalContentAlignment="Center" AutomationProperties.Name="{DynamicResource NoxText.ServerProtocol}"
                                      SelectionChanged="ServerScheme_Changed">
                                <ComboBoxItem Content="HTTPS"/>
                                <ComboBoxItem Content="HTTP" ToolTip="{DynamicResource NoxText.UnencryptedConnectionUseHTTPOnlyFor}"/>
                            </ComboBox>
                        <TextBox x:Name="ServerUrlTextBox" Grid.Column="1"
                                 AutomationProperties.Name="{DynamicResource NoxText.ServerAddress}" Text="localhost:7003"
                                 TextChanged="ServerUrlTextBox_TextChanged" />
                        </Grid>

                        <CheckBox x:Name="RememberServerCheckBox"
                                  Content="{DynamicResource NoxText.RememberServer}"
                                  Margin="0,0,0,16"
                                  FontSize="14"
                                  Foreground="{StaticResource TextMutedBrush}"
                                  Unchecked="RememberServerCheckBox_Unchecked" />

                        <TextBlock x:Name="UsernameLabelTextBlock"
                                   Text="{DynamicResource NoxText.Username}"
                                   FontSize="17"
                                   Visibility="Collapsed"
                                   Foreground="{StaticResource TextMutedBrush}" />
                        <TextBox x:Name="UsernameTextBox"
                                 TextChanged="UsernameTextBox_Changed"
                                 Margin="0,4,0,10" Height="40"
                                 Visibility="Collapsed"
                                 IsEnabled="False" />

                        <TextBlock x:Name="PasswordLabelTextBlock"
                                   Text="{DynamicResource NoxText.Password}"
                                   FontSize="17"
                                   Visibility="Collapsed"
                                   Foreground="{StaticResource TextMutedBrush}" />
                        <PasswordBox x:Name="PasswordBox"
                                     PasswordChanged="RegistrationPassword_Changed"
                                     Margin="0,4,0,10"
                                     Height="40"
                                     Visibility="Collapsed"
                                     IsEnabled="False" />
                        <TextBlock x:Name="RegistrationPasswordHint" Visibility="Collapsed" Height="68" TextWrapping="Wrap"
                                   FontSize="13" Margin="0,0,0,6"
                                   AutomationProperties.LiveSetting="Polite"/>

                        <TextBlock x:Name="AuthErrorTextBlock" MinHeight="22"
                                   Text=""
                                   Foreground="#FF6B6B"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,14" />

                        <Grid>
                        <Button x:Name="SignInButton"
                                FontSize="18"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Height="48"
                                HorizontalAlignment="Stretch"
                                Content="{DynamicResource NoxText.Connect}"
                                Click="SignInButton_Click" />

                        <Button x:Name="CreateAccountButton"
                                Style="{StaticResource PrimaryButtonStyle}" Padding="14,0"
                                FontSize="18"
                                Height="48"
                                HorizontalAlignment="Stretch"
                                Content="{DynamicResource NoxText.Register}"
                                Visibility="Collapsed"
                                Click="CreateAccountButton_Click" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
            </StackPanel>
            </Viewbox>
            <ComboBox x:Name="LoginLanguageBox" Style="{StaticResource SelectorStyle}" Grid.Row="1" HorizontalAlignment="Right" Width="92" Height="30" VerticalAlignment="Center" Margin="4,0,6,0"
                                  SelectedValuePath="Tag" SelectionChanged="Language_Changed" AutomationProperties.Name="{DynamicResource NoxText.Language}">
                        <ComboBoxItem Tag="it" Content="Italiano"/><ComboBoxItem Tag="en" Content="English"/>
                    </ComboBox>
            <TextBlock x:Name="ClientVersionLabel"
                       Grid.Row="1"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Bottom"
                       Margin="16,0,0,12"
                       FontSize="12"
                       Foreground="#D8DEE9"
                       IsHitTestVisible="False" />
        </Grid>

        <!-- MAIN DASHBOARD -->
        <Grid x:Name="MainShell"
              Visibility="Collapsed"
              Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- TOP BAR -->
            <Grid Margin="0,0,0,12" x:Name="DashboardHeader">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid Margin="0,0,8,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Image Source="Assets/NoxLogo.ico" Width="88" Height="88" Margin="0,0,9,0"/>
                    <TextBlock Grid.Column="1" x:Name="SignedInUserTextBlock" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}" Foreground="{StaticResource TextPrimaryBrush}"/>
                </Grid>
                <StackPanel Grid.Column="1" x:Name="HeaderActions" Orientation="Horizontal">
                    <ComboBox x:Name="DashboardLanguageBox" Style="{StaticResource SelectorStyle}" Width="92" Height="30" VerticalAlignment="Center" Margin="4,0,6,0"
                                  SelectedValuePath="Tag" SelectionChanged="Language_Changed" AutomationProperties.Name="{DynamicResource NoxText.Language}">
                        <ComboBoxItem Tag="it" Content="Italiano"/><ComboBoxItem Tag="en" Content="English"/>
                    </ComboBox>
                    <Button x:Name="LogoutButton" Click="LogoutButton_Click" Height="36" Padding="10,0" Margin="0,0,5,0" AutomationProperties.Name="{DynamicResource NoxText.Logout}">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="SignOut24" FontSize="17"/><TextBlock Text="{DynamicResource NoxText.Logout}" VerticalAlignment="Center" Margin="6,0,0,0"/></StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- CONTENT -->
            <Grid Grid.Row="1">
                    <TabControl x:Name="WorkspaceTabs" SelectionChanged="WorkspaceTab_Changed" Background="Transparent"
                                BorderThickness="0" Padding="0"
                                Foreground="{StaticResource TextPrimaryBrush}">
                        <TabControl.Template>
                            <ControlTemplate TargetType="TabControl">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                                    <TabPanel IsItemsHost="True" Margin="0,0,0,-1" Panel.ZIndex="1" KeyboardNavigation.TabIndex="1"/>
                                    <Border Grid.Row="1" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="0,8,8,8" Padding="16,0,16,12">
                                        <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                                    </Border>
                                </Grid>
                            </ControlTemplate>
                        </TabControl.Template>
                        <TabControl.Resources>
                            <Style TargetType="TabItem">
                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                <Setter Property="Background" Value="#121722" />
                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                <Setter Property="BorderThickness" Value="1,1,1,0" />
                                <Setter Property="Padding" Value="16,9" />
                                <Setter Property="Margin" Value="0,0,3,0" />
                                <Setter Property="FontSize" Value="15" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TabItem">
                                            <Border x:Name="TabBorder"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="8,8,0,0"
                                                    Padding="{TemplateBinding Padding}"
                                                    Margin="{TemplateBinding Margin}">
                                                <ContentPresenter x:Name="ContentSite"
                                                                  ContentSource="Header"
                                                                  RecognizesAccessKey="True"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                    <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TabControl.Resources>

                        <TabItem>
                            <TabItem.Header>
                                <TextBlock Text="{DynamicResource NoxText.SendFiles}" />
                            </TabItem.Header>

                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                            <StackPanel Width="648" Margin="0,8,0,0">
                                <TextBlock Text="{DynamicResource NoxText.Recipient}" FontSize="18" FontWeight="SemiBold"
                                           Margin="0,0,0,8"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextMutedBrush}" />

                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Grid x:Name="RecipientInput" Margin="0,0,10,0">
                            <TextBox x:Name="RecipientUsernameTextBox"
                                     Grid.Column="0"
                                     Padding="34,0,48,0"
                                     PreviewKeyDown="RecipientUsername_KeyDown"
                                     Foreground="{StaticResource TextMutedBrush}"
                                     PreviewMouseDown="RecipientUsernameTextBox_PreviewMouseDown"
                                     GotKeyboardFocus="RecipientUsernameTextBox_GotKeyboardFocus"
                                     LostKeyboardFocus="RecipientUsernameTextBox_LostKeyboardFocus"
                                     TextChanged="RecipientUsernameTextBox_TextChanged" />
                            <ui:SymbolIcon IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Center"
                                           Margin="10,0,0,0" FontSize="16" Foreground="{StaticResource TextMutedBrush}" Symbol="Search24"/>

                            <ComboBox x:Name="TrustedRecipientsComboBox"
                                      AutomationProperties.Name="{DynamicResource NoxText.OpenTrustedContacts}"
                                      Height="46"
                                      Background="#121722"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      BorderBrush="{StaticResource BorderBrush}"
                                      SelectionChanged="TrustedRecipientsComboBox_SelectionChanged">
                                <ComboBox.Template>
                                    <ControlTemplate TargetType="ComboBox">
                                        <Grid>
                                            <ToggleButton HorizontalAlignment="Right" Width="44" ToolTip="{DynamicResource NoxText.TrustedContactsAlt}" Focusable="False"
                                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                          ClickMode="Press"
                                                          Background="#121722"
                                                          BorderBrush="{StaticResource BorderBrush}"
                                                          BorderThickness="1">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border x:Name="ComboSurface" CornerRadius="6" Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
                                                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="ComboSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                                <Grid>
                                                    <Path Data="M 0 0 L 4 4 L 8 0 Z"
                                                          Width="8"
                                                          Height="4"
                                                          HorizontalAlignment="Right"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,14,0"
                                                          Fill="{StaticResource TextMutedBrush}" />
                                                </Grid>
                                            </ToggleButton>

                                            <Popup x:Name="PART_Popup"
                                                   AllowsTransparency="True"
                                                   Focusable="False"
                                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                                   Placement="Bottom"
                                                   PopupAnimation="Slide">
                                                <Border MinWidth="{TemplateBinding ActualWidth}"
                                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                                        Background="#121722"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1">
                                                    <ScrollViewer CanContentScroll="True">
                                                        <ItemsPresenter />
                                                    </ScrollViewer>
                                                </Border>
                                            </Popup>
                                        </Grid>
                                    </ControlTemplate>
                                </ComboBox.Template>

                                <ComboBox.Resources>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#121722" />
                                    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#121722" />
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#1B3A31" />
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#F3F6FB" />
                                    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#F3F6FB" />
                                </ComboBox.Resources>

                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Background" Value="#121722" />
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                        <Setter Property="Padding" Value="12,8" />
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>
                            </Grid>

                            <Button x:Name="CheckRecipientButton"
                                    Grid.Column="1"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Width="90"
                                    Content="{DynamicResource NoxText.Check}"
                                    Click="CheckRecipientButton_Click" />
                        </Grid>

                        <CheckBox x:Name="SendToSelfCheckBox"
                                  Margin="0,5,0,0"
                                  Content="{DynamicResource NoxText.SendToMyAccount}"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  FontSize="14"
                                  Checked="SendToSelfCheckBox_Changed"
                                  Unchecked="SendToSelfCheckBox_Changed" />

                        <TextBlock x:Name="RecipientStatusTextBlock"
                                   Height="40" LineHeight="20" LineStackingStrategy="BlockLineHeight"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                   Foreground="{StaticResource TextMutedBrush}" />

                        <DockPanel Margin="0,4,0,2">
                            <TextBlock Text="{DynamicResource NoxText.FilesToSend}" Visibility="Hidden" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{DynamicResource NoxText.Maximum20Files}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                        </DockPanel>
                        <Border x:Name="DropZoneBorder"
                                Focusable="True" ToolTip="{DynamicResource NoxText.SelectFilesUpTo20}" AutomationProperties.Name="{DynamicResource NoxText.SelectFiles}"
                                KeyDown="DropZoneBorder_KeyDown"
                                Margin="0,4,0,0"
                                Height="108"
                                CornerRadius="8"
                                Background="#111827"
                                AllowDrop="True"
                                IsEnabled="False"
                                DragEnter="DropZoneBorder_DragEnter"
                                DragLeave="DropZoneBorder_DragLeave"
                                Drop="DropZoneBorder_Drop"
                                MouseLeftButtonUp="DropZoneBorder_MouseLeftButtonUp">
                            <Grid>
                                <Rectangle Stroke="#617089"
                                           StrokeThickness="2"
                                           StrokeDashArray="7,5"
                                           RadiusX="8"
                                           RadiusY="8"
                                           IsHitTestVisible="False">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Fill" Value="Transparent"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsMouseOver, ElementName=DropZoneBorder}" Value="True"/>
                                                        <Condition Binding="{Binding IsEnabled, ElementName=DropZoneBorder}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Fill" Value="#2240D977"/>
                                                </MultiDataTrigger>
                                                <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=DropZoneBorder}" Value="True">
                                                    <Setter Property="Fill" Value="#268ADEDC"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>

                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            MaxWidth="760">
                                    <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems, ElementName=SelectedFilesItemsControl}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers></Style></StackPanel.Style>
                                    <ui:SymbolIcon Symbol="ArrowUpload24" FontSize="20" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,5"/>
                                    <TextBlock x:Name="DropZonePromptTextBlock"
                                               Text="{DynamicResource NoxText.SelectARecipient}" TextAlignment="Center" TextWrapping="Wrap"
                                               HorizontalAlignment="Center"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextMutedBrush}" />

                                </StackPanel>
                                <ScrollViewer Margin="6,4" PreviewMouseWheel="FileStrip_MouseWheel"
                                              VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto">
                                    <ScrollViewer.Style><Style TargetType="ScrollViewer"><Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems, ElementName=SelectedFilesItemsControl}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers></Style></ScrollViewer.Style>
                                        <ItemsControl x:Name="SelectedFilesItemsControl" VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="116" Margin="0,0,5,0" Padding="4,3" CornerRadius="5"
                                                            Background="{StaticResource PanelBackgroundBrush}" ToolTip="{Binding Name}">
                                                        <StackPanel>
                                                            <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="23" Foreground="{StaticResource AccentBrush}"/>
                                                            <TextBlock Text="{Binding Size}" TextAlignment="Center" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                                            <TextBlock Text="{Binding Name}" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                            </Grid>
                        </Border>

                        <ListBox x:Name="SelectedFilesListBox"
                                 Visibility="Collapsed"
                                 Margin="0,14,0,0"
                                 MinHeight="84"
                                 MaxHeight="145"
                                 Background="#111827"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderBrush="{StaticResource BorderBrush}" />

                        <TextBlock x:Name="SelectedFilesStatusTextBlock"
                                   Height="40" LineHeight="20" LineStackingStrategy="BlockLineHeight"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                   Foreground="{StaticResource TextMutedBrush}" />

                        <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <ProgressBar x:Name="SendProgressBar" Grid.Column="1" VerticalAlignment="Center"
                                     Margin="16,0,0,0"
                                     Height="8"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0"
                                     Visibility="Collapsed"
                                     Background="#111827"
                                     Foreground="{StaticResource PrimaryBrush}" />

                        <Button x:Name="SendEncryptedButton"
                                Margin="0"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="170"
                                HorizontalAlignment="Left"
                                Content="{DynamicResource NoxText.Send}"
                                IsEnabled="False"
                                Click="SendEncryptedButton_Click" />
                        </Grid>
                            </StackPanel></Viewbox>
                        </TabItem>

                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource NoxText.IncomingFiles}" />
                                    <Ellipse x:Name="InboxPresenceIndicator"
                                             Width="9"
                                             Height="9"
                                             Margin="8,2,0,0"
                                             Fill="#AAB4C3" />
                                </StackPanel>
                            </TabItem.Header>

                            <Grid Margin="0,12,0,2">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,14,0,0">
                            <Button x:Name="RefreshInboxButton"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Width="130"
                                    Content="{DynamicResource NoxText.Refresh}"
                                    Click="RefreshInboxButton_Click" />

                            <Button x:Name="DownloadDecryptButton"
                                    Margin="12,0,0,0"
                                    Width="170"
                                    Content="{DynamicResource NoxText.Download}"
                                    IsEnabled="False"
                                    Background="Transparent"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    Click="DownloadDecryptButton_Click" />
                        </StackPanel>

                        <ListBox x:Name="InboxListBox" Grid.Row="1"
                                 Margin="0,14,0,0"
                                 BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 Background="Transparent"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderBrush="{StaticResource BorderBrush}"
                                 SelectionChanged="InboxListBox_SelectionChanged">
                            <ListBox.Style><Style TargetType="ListBox"><Style.Triggers>
                                <Trigger Property="HasItems" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                            </Style.Triggers></Style></ListBox.Style>
                            <ListBox.ItemTemplate><DataTemplate>
                                <Border Padding="10,6" CornerRadius="5" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                                </Border>
                            </DataTemplate></ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="2">
                        <CheckBox x:Name="UseDefaultDownloadDirectoryCheckBox"
                                  Content="{DynamicResource NoxText.SaveToTheDefaultFolder}"
                                  Margin="0,12,0,0"
                                  FontSize="14"
                                  Foreground="{StaticResource TextMutedBrush}"
                                  Checked="UseDefaultDownloadDirectoryCheckBox_Changed"
                                  Unchecked="UseDefaultDownloadDirectoryCheckBox_Changed" />

                        <Grid Margin="0,8,0,0">
                            <TextBox x:Name="DefaultDownloadDirectoryTextBox" Padding="12,0,52,0"
                                     IsReadOnly="True" Foreground="{StaticResource TextMutedBrush}"/>
                            <Button x:Name="ChooseDefaultDownloadDirectoryButton" HorizontalAlignment="Right" Width="40" Height="36"
                                    Margin="0,0,5,0" Padding="0" ToolTip="{DynamicResource NoxText.ChooseDefaultFolder}" AutomationProperties.Name="{DynamicResource NoxText.ChooseDefaultFolder}"
                                    Click="ChooseDefaultDownloadDirectoryButton_Click"><ui:SymbolIcon Symbol="FolderOpen24" FontSize="19"/></Button>
                        </Grid>

                        <TextBlock x:Name="InboxStatusTextBlock"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextMutedBrush}" />

                        <ProgressBar x:Name="InboxProgressBar"
                                     Margin="0,12,0,0"
                                     Height="8"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0"
                                     Visibility="Collapsed"
                                     Background="#111827"
                                     Foreground="{StaticResource PrimaryBrush}" />
                            </StackPanel></Grid>
                        </TabItem>
                        <TabItem x:Name="IdentityTab" Header="{DynamicResource NoxText.Identity}">
                            <StackPanel Margin="0,16,0,0">
                                <TextBlock x:Name="IdentityUsername" FontSize="19" FontWeight="SemiBold"/>
                                <TextBlock Text="{DynamicResource NoxText.FullFingerprint}" Margin="0,10,0,4"/>
                                <TextBox x:Name="IdentityFingerprint" IsReadOnly="True" Height="128" FontFamily="Consolas" FontSize="21"/>
                                <Button Content="{DynamicResource NoxText.Copy}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="CopyIdentity_Click"/>
                            </StackPanel>
                        </TabItem>
                        <TabItem x:Name="ContactsTab" Header="{DynamicResource NoxText.TrustedContactsAlt}">
                            <Grid Margin="0,12,0,0">
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <ListBox x:Name="TrustedContactsListBox" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="TrustedContactsListBox_SelectionChanged">
                                    <ListBox.ItemTemplate><DataTemplate>
                                        <StackPanel><TextBlock Text="{Binding Username}" FontWeight="SemiBold"/>
                                            <ItemsControl ItemsSource="{Binding Groups}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate><DataTemplate>
                                                    <Border Background="{StaticResource AppBackgroundBrush}" CornerRadius="4" Margin="2" Padding="4">
                                                        <TextBlock Text="{Binding}" FontFamily="Consolas" HorizontalAlignment="Center" Foreground="{StaticResource AccentBrush}"/>
                                                    </Border>
                                                </DataTemplate></ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                                <DockPanel Grid.Row="1" Margin="0,8,0,0">
                                    <Button DockPanel.Dock="Right" x:Name="RemoveTrustedContactButton" Content="{DynamicResource NoxText.RemoveContact}" IsEnabled="False" Click="RemoveTrustedContactButton_Click"/>
                                    <TextBlock x:Name="ContactsStatus" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                                </DockPanel>
                            </Grid>
                        </TabItem>
                    </TabControl>
            </Grid>
        </Grid>
    </Grid>
    </DockPanel>
</Window>
