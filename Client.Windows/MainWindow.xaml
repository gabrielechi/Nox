<Window x:Class="Client.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Title="{DynamicResource NoxText.EndToEndEncryptedFileTransfer}"
        Icon="Assets/NoxWindows.ico"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource NoxFontFamily}"
        FontSize="14"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="0" GlassFrameThickness="0"
                      CornerRadius="6" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <DockPanel>
        <DockPanel.Style>
            <Style TargetType="DockPanel">
                <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Visibility, ElementName=AuthScreen}" Value="Visible">
                        <Setter Property="Background">
                            <Setter.Value>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#14211C"/><GradientStop Color="#0E1116" Offset=".7"/>
                                </LinearGradientBrush>
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </DockPanel.Style>

        <!-- CAPTION BAR -->
        <Grid DockPanel.Dock="Top" Height="34" Background="Transparent">
            <Grid.Resources>
                <Style x:Key="CaptionAction" TargetType="Button">
                    <Setter Property="Width" Value="44"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{StaticResource NoxTextMutedBrush}"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource NoxRaisedBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource NoxTextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="Background" Value="{StaticResource NoxRaisedHoverBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource NoxTextBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Grid.Resources>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <!-- Continues the sidebar surface under the caption while the dashboard is shown. -->
            <Border Width="240" HorizontalAlignment="Left"
                    Background="{StaticResource NoxSidebarBrush}" BorderBrush="{StaticResource NoxBorderBrush}" BorderThickness="0,0,1,0"
                    Visibility="{Binding Visibility, ElementName=MainShell}"/>
            <Button x:Name="MinimizeWindowButton" Grid.Column="1" Style="{StaticResource CaptionAction}"
                    AutomationProperties.Name="{DynamicResource NoxText.Minimize}" Click="MinimizeWindow_Click">
                <Path Data="M0,0 L10,0" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Button>
            <Button x:Name="CloseWindowButton" Grid.Column="2" AutomationProperties.Name="{DynamicResource NoxText.Close}" Click="CloseWindow_Click">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource CaptionAction}">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource NoxDangerBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Button>
        </Grid>
    <Grid x:Name="AppRoot">

        <!-- AUTH SCREEN -->
        <Grid x:Name="AuthScreen"
              Visibility="Visible"
              Margin="0">
            <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="38"/></Grid.RowDefinitions>
            <Grid x:Name="AuthSurface" Width="416" VerticalAlignment="Top" HorizontalAlignment="Center">
            <Grid.RowDefinitions><RowDefinition Height="100"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel x:Name="AuthBrand" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0">
                <Image Source="Assets/NoxLogo.ico" Width="72" Height="72"/>
                <TextBlock Text="NOX" VerticalAlignment="Center" FontFamily="{StaticResource NoxFontFamily}"
                           FontSize="36" FontWeight="Bold" Margin="12,0,0,0" Foreground="{StaticResource TextPrimaryBrush}"/>
            </StackPanel>
            <Grid Grid.Row="1" Margin="20,0">
                <Border x:Name="AuthCard" Style="{StaticResource AuthCardStyle}" MaxWidth="408"
                        Background="{StaticResource PanelBackgroundBrush}" Padding="24" VerticalAlignment="Top">
                    <StackPanel x:Name="AuthCardContent">
                        <TextBlock x:Name="AuthHeading" Text="{DynamicResource NoxText.Server}" Style="{StaticResource NoxTitleText}"
                                   Margin="0,0,0,16"/>
                        <Grid x:Name="ConnectedServerSummary" Visibility="Collapsed" Height="44" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Ellipse Width="8" Height="8" Fill="{StaticResource NoxAccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ConnectedServerUrl" Grid.Column="1" FontSize="14" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                            <Button x:Name="ChangeServerButton" Grid.Column="2" Style="{StaticResource NoxIconButtonStyle}"
                                    Width="40" Height="40" Margin="8,0,0,0"
                                    AutomationProperties.Name="{DynamicResource NoxText.ChangeServer}"
                                    Click="ChangeServer_Click">
                                <Viewbox Width="18" Height="18">
                                    <Path Style="{StaticResource NoxIconPath}" Data="{StaticResource NoxIconEdit}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </Viewbox>
                            </Button>
                        </Grid>
                        <StackPanel x:Name="ServerConnectionFields">
                        <Grid Margin="0,0,0,12">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource NoxText.Protocol}" Style="{StaticResource NoxLabelText}" Margin="0,0,8,6"/>
                            <TextBlock Grid.Column="1" Text="{DynamicResource NoxText.ServerURL}" Style="{StaticResource NoxLabelText}" Margin="0,0,0,6"/>
                            <ComboBox x:Name="ServerSchemeBox" Grid.Row="1" Style="{StaticResource SelectorStyle}" SelectedIndex="0" Margin="0,0,8,0" Height="46"
                                      VerticalContentAlignment="Center" AutomationProperties.Name="{DynamicResource NoxText.ServerProtocol}"
                                      SelectionChanged="ServerScheme_Changed">
                                <ComboBoxItem Content="HTTPS"/>
                                <ComboBoxItem Content="HTTP"/>
                            </ComboBox>
                        <TextBox x:Name="ServerUrlTextBox" Grid.Row="1" Grid.Column="1"
                                 AutomationProperties.Name="{DynamicResource NoxText.ServerAddress}" Text="localhost:7003"
                                 TextChanged="ServerUrlTextBox_TextChanged" />
                        </Grid>

                        <CheckBox x:Name="RememberServerCheckBox"
                                  Content="{DynamicResource NoxText.RememberServer}"
                                  Margin="0,0,0,16"
                                  FontSize="14"
                                  Foreground="{StaticResource TextMutedBrush}"
                                  Unchecked="RememberServerCheckBox_Unchecked" />
                        </StackPanel>

                        <TextBlock x:Name="UsernameLabelTextBlock"
                                   Text="{DynamicResource NoxText.Username}"
                                   Style="{StaticResource NoxLabelText}"
                                   Visibility="Collapsed" />
                        <TextBox x:Name="UsernameTextBox"
                                 TextChanged="UsernameTextBox_Changed"
                                 Margin="0,6,0,12" Height="46"
                                 Visibility="Collapsed"
                                 IsEnabled="False" />

                        <TextBlock x:Name="PasswordLabelTextBlock"
                                   Text="{DynamicResource NoxText.Password}"
                                   Style="{StaticResource NoxLabelText}"
                                   Visibility="Collapsed" />
                        <PasswordBox x:Name="PasswordBox"
                                     PasswordChanged="RegistrationPassword_Changed"
                                     Margin="0,6,0,12"
                                     Height="46"
                                     Visibility="Collapsed"
                                     IsEnabled="False" />
                        <TextBlock x:Name="RegistrationPasswordHint" Visibility="Collapsed" Height="74" TextWrapping="Wrap"
                                   FontSize="12" LineHeight="18" LineStackingStrategy="BlockLineHeight" Margin="0,0,0,8"
                                   AutomationProperties.LiveSetting="Polite"/>

                        <StackPanel x:Name="PasswordStrengthPanel" Visibility="Collapsed" Margin="0,0,0,16">
                            <TextBlock x:Name="PasswordStrengthLabel" FontSize="12" Height="20"
                                       Foreground="{StaticResource TextMutedBrush}" AutomationProperties.LiveSetting="Polite"/>
                            <ProgressBar x:Name="PasswordStrengthBar" Height="6" Minimum="0" Maximum="4" Value="0"
                                         Background="{StaticResource NoxRaisedBrush}" Foreground="{StaticResource NoxTextMutedBrush}"
                                         AutomationProperties.Name="{DynamicResource NoxText.PasswordStrength}">
                                <ProgressBar.Template>
                                    <ControlTemplate TargetType="ProgressBar">
                                        <Grid x:Name="PART_Track" ClipToBounds="True">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="3"/>
                                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3"
                                                    Background="{TemplateBinding Foreground}"/>
                                        </Grid>
                                    </ControlTemplate>
                                </ProgressBar.Template>
                            </ProgressBar>
                        </StackPanel>
                        <Button x:Name="SwitchAuthModeButton" Click="SwitchAuthMode_Click"
                                Style="{StaticResource NoxLinkButtonStyle}"
                                Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,0,0,12"
                                MinHeight="24" Padding="0"
                                Foreground="{StaticResource TextMutedBrush}">
                            <TextBlock x:Name="SwitchAuthModeLabel" FontSize="13" TextDecorations="Underline"
                                       Text="{DynamicResource NoxText.NoAccount}"/>
                        </Button>
                        <ScrollViewer x:Name="AuthNotice" Visibility="Collapsed" MaxHeight="112" Margin="0,0,0,12"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="AuthErrorTextBlock"
                                   Text=""
                                   Foreground="#FF6B6B"
                                   TextWrapping="Wrap"/>
                        </ScrollViewer>

                        <Grid>
                        <Button x:Name="SignInButton"
                                IsDefault="True"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Height="48"
                                HorizontalAlignment="Stretch"
                                Content="{DynamicResource NoxText.Connect}"
                                Click="SignInButton_Click" />

                        <Button x:Name="CreateAccountButton"
                                Style="{StaticResource PrimaryButtonStyle}" Padding="14,0"
                                Height="48"
                                HorizontalAlignment="Stretch"
                                Content="{DynamicResource NoxText.Register}"
                                Visibility="Collapsed"
                                Click="CreateAccountButton_Click" />
                        </Grid>
                    </StackPanel>
                </Border>
                <Canvas IsHitTestVisible="False" Panel.ZIndex="1">
                    <Image x:Name="AuthCardPreview" Visibility="Collapsed" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                </Canvas>
            </Grid>
            </Grid>
            <ComboBox x:Name="LoginLanguageBox" Style="{StaticResource SelectorStyle}" BorderThickness="0" Background="Transparent"
                      Foreground="{StaticResource TextMutedBrush}" Padding="10,0"
                      Grid.Row="1" HorizontalAlignment="Right" Width="104" Height="30" VerticalAlignment="Center" Margin="4,0,8,0"
                                  SelectedValuePath="Tag" SelectionChanged="Language_Changed" AutomationProperties.Name="{DynamicResource NoxText.Language}">
                        <ComboBoxItem Tag="it" Content="Italiano"/><ComboBoxItem Tag="en" Content="English"/>
                    </ComboBox>
            <TextBlock x:Name="ClientVersionLabel"
                       Grid.Row="1"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Bottom"
                       Margin="16,0,0,12"
                       FontSize="12"
                       Foreground="{StaticResource NoxTextDisabledBrush}"
                       IsHitTestVisible="False" />
        </Grid>

        <!-- MAIN DASHBOARD: fixed sidebar | flexible content (| summary column on some pages) -->
        <Grid x:Name="MainShell"
              Visibility="Collapsed"
              Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar surface -->
            <Border Grid.Column="0" Background="{StaticResource NoxSidebarBrush}"
                    BorderBrush="{StaticResource NoxBorderBrush}" BorderThickness="0,0,1,0"/>

            <!-- Navigation + pages. The tab strip is drawn inside the sidebar column,
                 the selected page in the flexible column. -->
            <TabControl x:Name="WorkspaceTabs" Grid.ColumnSpan="2" SelectionChanged="WorkspaceTab_Changed" Background="Transparent"
                        BorderThickness="0" Padding="0"
                        Foreground="{StaticResource TextPrimaryBrush}">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel IsItemsHost="True" Margin="16,92,16,0" VerticalAlignment="Top"
                                        KeyboardNavigation.TabIndex="1"/>
                            <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Column="1" Margin="36,24,36,32"
                                              ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </TabControl.Template>
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                        <Setter Property="Padding" Value="12,0" />
                        <Setter Property="MinHeight" Value="44" />
                        <Setter Property="FontSize" Value="14" />
                        <Setter Property="Cursor" Value="Hand" />
                        <!-- TabControl lays out the selected page with the item's content alignment: keep it Stretch. -->
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        <Setter Property="FocusVisualStyle" Value="{StaticResource NoxFocusVisual}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Grid x:Name="TabBorder" Margin="0,0,0,4">
                                        <Border x:Name="HoverPill" CornerRadius="10" Opacity="0" Background="{StaticResource NoxCardHoverBrush}"/>
                                        <Border x:Name="SelectedPill" CornerRadius="10" Opacity="0" Background="{StaticResource NoxRaisedBrush}"/>
                                        <ContentPresenter x:Name="ContentSite"
                                                          ContentSource="Header"
                                                          RecognizesAccessKey="True"
                                                          Margin="{TemplateBinding Padding}"
                                                          HorizontalAlignment="Left"
                                                          VerticalAlignment="Center" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverPill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                            </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                            <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverPill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                            </Storyboard></BeginStoryboard></Trigger.ExitActions>
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="SelectedPill" Property="Opacity" Value="1"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="SelectedPill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                                            </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                            <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="SelectedPill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                            </Storyboard></BeginStoryboard></Trigger.ExitActions>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <!-- ===== SEND ===== -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Path Style="{StaticResource NoxNavIconPath}" Data="{StaticResource NoxIconArrowUp}"/>
                            </Viewbox>
                            <TextBlock Text="{DynamicResource NoxText.SendFiles}" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="{DynamicResource NoxText.SendFiles}" Style="{StaticResource NoxTitleText}"
                                   Margin="0,0,0,24" TextTrimming="CharacterEllipsis"/>

                        <!-- Step 1: recipient -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="{DynamicResource NoxText.Recipient}" Style="{StaticResource NoxSectionTitleText}"
                                       Margin="0" VerticalAlignment="Center" />
                        </StackPanel>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Grid x:Name="RecipientInput" Margin="0,0,8,0">
                            <TextBox x:Name="RecipientUsernameTextBox"
                                     Grid.Column="0"
                                     Padding="42,0,52,0"
                                     PreviewKeyDown="RecipientUsername_KeyDown"
                                     Foreground="{StaticResource TextMutedBrush}"
                                     PreviewMouseDown="RecipientUsernameTextBox_PreviewMouseDown"
                                     GotKeyboardFocus="RecipientUsernameTextBox_GotKeyboardFocus"
                                     LostKeyboardFocus="RecipientUsernameTextBox_LostKeyboardFocus"
                                     TextChanged="RecipientUsernameTextBox_TextChanged">
                                <TextBox.Style>
                                    <!-- Locked after a successful check: read-only, drawn on the sidebar colour. -->
                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                        <Style.Triggers>
                                            <Trigger Property="IsReadOnly" Value="True">
                                                <Setter Property="Background" Value="{StaticResource NoxSidebarBrush}"/>
                                                <Setter Property="Cursor" Value="Arrow"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <Viewbox IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Center"
                                     Margin="14,0,0,0" Width="18" Height="18">
                                <Path Style="{StaticResource NoxIconPath}" Data="{StaticResource NoxIconSearch}"/>
                            </Viewbox>

                            <ComboBox x:Name="TrustedRecipientsComboBox"
                                      AutomationProperties.Name="{DynamicResource NoxText.OpenTrustedContacts}"
                                      Height="46"
                                      SelectionChanged="TrustedRecipientsComboBox_SelectionChanged">
                                <ComboBox.Template>
                                    <ControlTemplate TargetType="ComboBox">
                                        <Grid>
                                            <ToggleButton x:Name="Toggle" HorizontalAlignment="Right" Width="40" Margin="0,4,4,4"
                                                          AutomationProperties.Name="{DynamicResource NoxText.TrustedContactsAlt}" Focusable="False"
                                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                          ClickMode="Press">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border x:Name="ComboSurface" CornerRadius="8" Background="Transparent">
                                                            <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <Path x:Name="Glyph" Style="{StaticResource NoxIconPath}" Data="{StaticResource NoxIconChevronDown}" StrokeThickness="2.2"/>
                                                            </Viewbox>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ComboSurface" Property="Background" Value="{StaticResource NoxRaisedBrush}"/>
                                                                <Setter TargetName="Glyph" Property="Stroke" Value="{StaticResource NoxTextBrush}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="ComboSurface" Property="Background" Value="{StaticResource NoxRaisedBrush}"/>
                                                                <Setter TargetName="Glyph" Property="Stroke" Value="{StaticResource NoxAccentBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                            </ToggleButton>

                                            <Popup x:Name="PART_Popup"
                                                   AllowsTransparency="True"
                                                   Focusable="False"
                                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                                   Placement="Bottom"
                                                   VerticalOffset="4"
                                                   PopupAnimation="Fade">
                                                <Border MinWidth="{TemplateBinding ActualWidth}"
                                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                                        Background="{StaticResource NoxRaisedBrush}"
                                                        BorderBrush="{StaticResource NoxBorderStrongBrush}"
                                                        BorderThickness="1" CornerRadius="12" Padding="4">
                                                    <ScrollViewer CanContentScroll="True">
                                                        <ItemsPresenter />
                                                    </ScrollViewer>
                                                </Border>
                                            </Popup>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Toggle" Property="Opacity" Value="0.35"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ComboBox.Template>
                            </ComboBox>
                            </Grid>

                            <!-- Accent "Check"; once the recipient is verified (field read-only) it becomes the amber pencil. -->
                            <Button x:Name="CheckRecipientButton"
                                    Grid.Column="1"
                                    Width="96"
                                    Content="{DynamicResource NoxText.Check}"
                                    Click="CheckRecipientButton_Click">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsReadOnly, ElementName=RecipientUsernameTextBox}" Value="True">
                                                <Setter Property="Template" Value="{StaticResource NoxEditButtonTemplate}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <CheckBox x:Name="SendToSelfCheckBox"
                                  Grid.Row="3"
                                  Margin="0,12,0,0"
                                  HorizontalAlignment="Left"
                                  Content="{DynamicResource NoxText.SendToMyAccount}"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  FontSize="14"
                                  Checked="SendToSelfCheckBox_Changed"
                                  Unchecked="SendToSelfCheckBox_Changed" />

                        <TextBlock x:Name="RecipientStatusTextBlock"
                                   Grid.Row="4"
                                   Height="40" LineHeight="20" LineStackingStrategy="BlockLineHeight"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                   Foreground="{StaticResource TextMutedBrush}" />

                        <!-- Step 2: files, with the selection count next to the heading -->
                        <Grid Grid.Row="5" Margin="0,4,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="{DynamicResource NoxText.FilesToSend}" Style="{StaticResource NoxSectionTitleText}"
                                       Margin="0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SelectedFilesStatusTextBlock"
                                       Grid.Column="2"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="14" LineHeight="20" LineStackingStrategy="BlockLineHeight" MaxHeight="40"
                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                       Foreground="{StaticResource TextMutedBrush}" />
                        </Grid>

                        <Border x:Name="DropZoneBorder"
                                Grid.Row="6"
                                Focusable="True" AutomationProperties.Name="{DynamicResource NoxText.SelectFiles}"
                                FocusVisualStyle="{StaticResource NoxFocusVisual}"
                                KeyDown="DropZoneBorder_KeyDown"
                                MinHeight="150"
                                CornerRadius="16"
                                Background="#111827"
                                AllowDrop="True"
                                IsEnabled="False"
                                DragEnter="DropZoneBorder_DragEnter"
                                DragLeave="DropZoneBorder_DragLeave"
                                Drop="DropZoneBorder_Drop"
                                MouseLeftButtonUp="DropZoneBorder_MouseLeftButtonUp">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsEnabled" Value="True"><Setter Property="Cursor" Value="Hand"/></Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <!-- Visual surface. It covers the background colour that code-behind assigns
                                     on drag enter/leave and turns that change into the accent drag-over state. -->
                                <Border CornerRadius="16" IsHitTestVisible="False">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource NoxSidebarBrush}"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsMouseOver, ElementName=DropZoneBorder}" Value="True"/>
                                                        <Condition Binding="{Binding IsEnabled, ElementName=DropZoneBorder}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Background" Value="{StaticResource NoxCardHoverBrush}"/>
                                                </MultiDataTrigger>
                                                <DataTrigger Binding="{Binding Background.Color, ElementName=DropZoneBorder}" Value="#FF15372B">
                                                    <Setter Property="Background" Value="{StaticResource NoxAccentSubtleBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <Rectangle StrokeThickness="2"
                                           StrokeDashArray="3,2.5"
                                           RadiusX="16"
                                           RadiusY="16"
                                           IsHitTestVisible="False">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Fill" Value="Transparent"/>
                                            <Setter Property="Stroke" Value="{StaticResource NoxBorderStrongBrush}"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsMouseOver, ElementName=DropZoneBorder}" Value="True"/>
                                                        <Condition Binding="{Binding IsEnabled, ElementName=DropZoneBorder}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Stroke" Value="{StaticResource NoxTextDisabledBrush}"/>
                                                </MultiDataTrigger>
                                                <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=DropZoneBorder}" Value="True">
                                                    <Setter Property="Stroke" Value="{StaticResource NoxAccentBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Background.Color, ElementName=DropZoneBorder}" Value="#FF15372B">
                                                    <Setter Property="Stroke" Value="{StaticResource NoxAccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>

                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Margin="20"
                                            MaxWidth="760">
                                    <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems, ElementName=SelectedFilesItemsControl}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers></Style></StackPanel.Style>
                                    <Viewbox Width="36" Height="36" Margin="0,0,0,12" HorizontalAlignment="Center">
                                        <Path Data="{StaticResource NoxIconUpload}" StrokeThickness="1.8">
                                            <Path.Style>
                                                <Style TargetType="Path" BasedOn="{StaticResource NoxIconPath}">
                                                    <Setter Property="Stroke" Value="{StaticResource NoxTextDisabledBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEnabled, ElementName=DropZoneBorder}" Value="True">
                                                            <Setter Property="Stroke" Value="{StaticResource NoxAccentBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </Viewbox>
                                    <TextBlock x:Name="DropZonePromptTextBlock"
                                               Text="{DynamicResource NoxText.SelectARecipient}" TextAlignment="Center" TextWrapping="Wrap"
                                               HorizontalAlignment="Center"
                                               FontSize="16"
                                               FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource NoxTextMutedBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEnabled, ElementName=DropZoneBorder}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource NoxTextBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{DynamicResource NoxText.Maximum20Files}" Style="{StaticResource NoxLabelText}"
                                               HorizontalAlignment="Center" Margin="0,6,0,0"/>

                                </StackPanel>
                                <!-- Selected files: a vertical list of cards inside the drop area. -->
                                <ScrollViewer Margin="12" PreviewMouseWheel="FileStrip_MouseWheel"
                                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ScrollViewer.Style><Style TargetType="ScrollViewer"><Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems, ElementName=SelectedFilesItemsControl}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers></Style></ScrollViewer.Style>
                                        <ItemsControl x:Name="SelectedFilesItemsControl" VerticalAlignment="Top">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,8" Padding="14,10" CornerRadius="12" BorderThickness="1"
                                                            Background="{StaticResource NoxCardBrush}" BorderBrush="{StaticResource NoxBorderBrush}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Viewbox Width="22" Height="22" VerticalAlignment="Center">
                                                                <Path StrokeThickness="1.8">
                                                                    <Path.Style>
                                                                        <Style TargetType="Path" BasedOn="{StaticResource NoxIconPath}">
                                                                            <Setter Property="Data" Value="{StaticResource NoxIconFile}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Icon}" Value="DocumentPdf24"><Setter Property="Data" Value="{StaticResource NoxIconFilePdf}"/></DataTrigger>
                                                                                <DataTrigger Binding="{Binding Icon}" Value="Image24"><Setter Property="Data" Value="{StaticResource NoxIconImage}"/></DataTrigger>
                                                                                <DataTrigger Binding="{Binding Icon}" Value="Video24"><Setter Property="Data" Value="{StaticResource NoxIconVideo}"/></DataTrigger>
                                                                                <DataTrigger Binding="{Binding Icon}" Value="MusicNote124"><Setter Property="Data" Value="{StaticResource NoxIconMusic}"/></DataTrigger>
                                                                                <DataTrigger Binding="{Binding Icon}" Value="Archive24"><Setter Property="Data" Value="{StaticResource NoxIconArchive}"/></DataTrigger>
                                                                                <DataTrigger Binding="{Binding Icon}" Value="Table24"><Setter Property="Data" Value="{StaticResource NoxIconTable}"/></DataTrigger>
                                                                                <DataTrigger Binding="{Binding Icon}" Value="Code24"><Setter Property="Data" Value="{StaticResource NoxIconCode}"/></DataTrigger>
                                                                                <DataTrigger Binding="{Binding Icon}" Value="DocumentText24"><Setter Property="Data" Value="{StaticResource NoxIconFileText}"/></DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Path.Style>
                                                                </Path>
                                                            </Viewbox>
                                                            <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="14,0,12,0" VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Size}" VerticalAlignment="Center"
                                                                       Foreground="{StaticResource TextMutedBrush}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- Send, right under the drop area -->
                        <Grid Grid.Row="7" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <ProgressBar x:Name="SendProgressBar" Grid.Column="1" VerticalAlignment="Center"
                                         Margin="16,0,0,0"
                                         Height="8"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="0"
                                         Visibility="Collapsed"
                                         Background="{StaticResource NoxRaisedBrush}"
                                         Foreground="{StaticResource PrimaryBrush}" />

                            <Button x:Name="SendEncryptedButton"
                                    Margin="0"
                                    Style="{StaticResource NoxPrimaryLockButtonStyle}"
                                    Width="200"
                                    Height="48"
                                    HorizontalAlignment="Left"
                                    Content="{DynamicResource NoxText.Send}"
                                    IsEnabled="False"
                                    Click="SendEncryptedButton_Click" />
                        </Grid>

                        <ListBox x:Name="SelectedFilesListBox"
                                 Grid.Row="8"
                                 Visibility="Collapsed"
                                 Margin="0,14,0,0"
                                 MinHeight="84"
                                 MaxHeight="145"
                                 Background="{StaticResource NoxCardBrush}"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderBrush="{StaticResource BorderBrush}" />
                    </Grid>
                </TabItem>

                <!-- ===== INBOX ===== -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Viewbox Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Path Style="{StaticResource NoxNavIconPath}" Data="{StaticResource NoxIconArrowDown}"/>
                            </Viewbox>
                            <TextBlock Text="{DynamicResource NoxText.IncomingFiles}" VerticalAlignment="Center" />
                            <Ellipse x:Name="InboxPresenceIndicator"
                                     Width="8"
                                     Height="8"
                                     Margin="10,1,0,0"
                                     VerticalAlignment="Center"
                                     Fill="{StaticResource NoxTextMutedBrush}" />
                        </StackPanel>
                    </TabItem.Header>

                    <Grid Margin="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="{DynamicResource NoxText.IncomingFiles}" Style="{StaticResource NoxTitleText}"
                                   Margin="0,0,0,24" TextTrimming="CharacterEllipsis"/>

                        <StackPanel Grid.Row="1" Orientation="Horizontal"
                                    Margin="0,0,0,16">
                            <Button x:Name="RefreshInboxButton"
                                    Width="130"
                                    Height="46"
                                    Content="{DynamicResource NoxText.Refresh}"
                                    Click="RefreshInboxButton_Click" />

                            <Button x:Name="DownloadDecryptButton"
                                    Margin="12,0,0,0"
                                    Width="170"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Content="{DynamicResource NoxText.Download}"
                                    IsEnabled="False"
                                    Click="DownloadDecryptButton_Click" />
                        </StackPanel>

                        <!-- Empty state behind the list (the list collapses when it has no items). -->
                        <Border Grid.Row="2" CornerRadius="16" BorderThickness="1" MinHeight="120"
                                BorderBrush="{StaticResource NoxBorderBrush}" Background="{StaticResource NoxSidebarBrush}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems, ElementName=InboxListBox}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Viewbox Width="40" Height="40">
                                <Path Style="{StaticResource NoxIconPath}" Data="{StaticResource NoxIconInbox}" StrokeThickness="1.6"
                                      Stroke="{StaticResource NoxTextDisabledBrush}"/>
                            </Viewbox>
                        </Border>

                        <ListBox x:Name="InboxListBox" Grid.Row="2"
                                 Margin="0"
                                 BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 Background="Transparent"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderBrush="{StaticResource BorderBrush}"
                                 SelectionChanged="InboxListBox_SelectionChanged">
                            <ListBox.Template>
                                <ControlTemplate TargetType="ListBox">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                        <ScrollViewer x:Name="PART_ScrollViewer" Focusable="False">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </ControlTemplate>
                            </ListBox.Template>
                            <ListBox.Style><Style TargetType="ListBox"><Style.Triggers>
                                <Trigger Property="HasItems" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                            </Style.Triggers></Style></ListBox.Style>
                            <ListBox.ItemTemplate><DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="20" VerticalAlignment="Center"
                                            Background="{StaticResource NoxAccentMutedBrush}">
                                        <Viewbox Width="18" Height="18">
                                            <Path Style="{StaticResource NoxIconPath}" Data="{StaticResource NoxIconInbox}"
                                                  Stroke="{StaticResource NoxAccentBrush}"/>
                                        </Viewbox>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                </Grid>
                            </DataTemplate></ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Download settings and status, under the list -->
                        <Border Grid.Row="3" Margin="0,16,0,0" Style="{StaticResource NoxSideCardStyle}" Padding="20,16">
                        <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <Viewbox Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Path Style="{StaticResource NoxIconPath}" Data="{StaticResource NoxIconFolder}" Stroke="{StaticResource NoxAccentBrush}"/>
                            </Viewbox>
                            <TextBlock Text="{DynamicResource NoxText.DefaultFolder}" Style="{StaticResource NoxSectionTitleText}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <CheckBox x:Name="UseDefaultDownloadDirectoryCheckBox"
                                  Content="{DynamicResource NoxText.SaveToTheDefaultFolder}"
                                  Margin="0"
                                  HorizontalAlignment="Left"
                                  FontSize="14"
                                  Foreground="{StaticResource TextMutedBrush}"
                                  Checked="UseDefaultDownloadDirectoryCheckBox_Changed"
                                  Unchecked="UseDefaultDownloadDirectoryCheckBox_Changed" />

                        <Grid Margin="0,10,0,0">
                            <TextBox x:Name="DefaultDownloadDirectoryTextBox" Padding="14,0,52,0"
                                     IsReadOnly="True" Foreground="{StaticResource TextMutedBrush}"/>
                            <Button x:Name="ChooseDefaultDownloadDirectoryButton" Style="{StaticResource NoxIconButtonStyle}"
                                    HorizontalAlignment="Right" Width="38" Height="38"
                                    Margin="0,0,4,0" AutomationProperties.Name="{DynamicResource NoxText.ChooseDefaultFolder}"
                                    Click="ChooseDefaultDownloadDirectoryButton_Click">
                                <Viewbox Width="18" Height="18">
                                    <Path Style="{StaticResource NoxIconPath}" Data="{StaticResource NoxIconFolder}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </Viewbox>
                            </Button>
                        </Grid>

                        <TextBlock x:Name="InboxStatusTextBlock"
                                   Margin="0,12,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextMutedBrush}" />

                        <ProgressBar x:Name="InboxProgressBar"
                                     Margin="0,12,0,0"
                                     Height="8"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0"
                                     Visibility="Collapsed"
                                     Background="{StaticResource NoxRaisedBrush}"
                                     Foreground="{StaticResource PrimaryBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ===== IDENTITY ===== -->
                <TabItem x:Name="IdentityTab">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Path Style="{StaticResource NoxNavIconPath}" Data="{StaticResource NoxIconShield}"/>
                            </Viewbox>
                            <TextBlock Text="Fingerprint" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                        <TextBlock Text="{DynamicResource NoxText.Identity}" Style="{StaticResource NoxTitleText}" Margin="0,0,0,28"/>
                        <Border Grid.Row="1" Style="{StaticResource NoxSideCardStyle}" Padding="24" HorizontalAlignment="Stretch">
                            <StackPanel>
                                <TextBlock x:Name="IdentityUsername" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock Text="{DynamicResource NoxText.FullFingerprint}" Style="{StaticResource NoxLabelText}" Margin="0,6,0,16"/>
                                <ItemsControl x:Name="IdentityFingerprint">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <Border Background="{StaticResource AppBackgroundBrush}" BorderBrush="{StaticResource NoxBorderBrush}" BorderThickness="1"
                                                CornerRadius="10" Margin="4" Padding="10,10">
                                            <TextBlock Text="{Binding}" FontFamily="{StaticResource NoxMonoFontFamily}" FontSize="22" HorizontalAlignment="Center"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </Border>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button HorizontalAlignment="Left" Margin="0,20,0,0" Padding="16,0" Click="CopyIdentity_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                            <Path Style="{StaticResource NoxIconPath}" Data="{StaticResource NoxIconCopy}"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        </Viewbox>
                                        <TextBlock Text="{DynamicResource NoxText.Copy}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ===== TRUSTED CONTACTS ===== -->
                <TabItem x:Name="ContactsTab">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Path Style="{StaticResource NoxNavIconPath}" Data="{StaticResource NoxIconUsers}"/>
                            </Viewbox>
                            <TextBlock Text="{DynamicResource NoxText.TrustedContactsAlt}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <Grid Margin="0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="{DynamicResource NoxText.TrustedContactsAlt}" Style="{StaticResource NoxTitleText}" Margin="0,0,0,28"/>
                        <ListBox x:Name="TrustedContactsListBox" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="TrustedContactsListBox_SelectionChanged">
                            <ListBox.ItemTemplate><DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="20" VerticalAlignment="Top"
                                            Background="{StaticResource NoxRaisedBrush}">
                                        <Viewbox Width="18" Height="18">
                                            <Path Style="{StaticResource NoxIconPath}" Data="{StaticResource NoxIconUser}"/>
                                        </Viewbox>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                        <TextBlock Text="{Binding Username}" FontWeight="SemiBold" Margin="0,10,0,8" TextTrimming="CharacterEllipsis"/>
                                        <ItemsControl ItemsSource="{Binding Groups}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate><DataTemplate>
                                                <Border Background="{StaticResource AppBackgroundBrush}" CornerRadius="6" Margin="2" Padding="4,3">
                                                    <TextBlock Text="{Binding}" FontFamily="{StaticResource NoxMonoFontFamily}" FontSize="13"
                                                               HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                                                </Border>
                                            </DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <DockPanel Grid.Row="2" Margin="0,16,0,0">
                            <Button DockPanel.Dock="Right" x:Name="RemoveTrustedContactButton" Padding="16,0" IsEnabled="False" Click="RemoveTrustedContactButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                        <Path Style="{StaticResource NoxIconPath}" Data="{StaticResource NoxIconTrash}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </Viewbox>
                                    <TextBlock Text="{DynamicResource NoxText.RemoveContact}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="ContactsStatus" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                        </DockPanel>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- Brand, top of the sidebar -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="24,14,16,0" IsHitTestVisible="False">
                <Image Source="Assets/NoxLogo.ico" Width="56" Height="56"/>
                <TextBlock Text="NOX" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="35" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
            </StackPanel>

            <!-- Sidebar footer: language, logout and signed-in user.
                 Code-behind may move HeaderActions inside this 2x2 grid (compact layout). -->
            <Grid x:Name="DashboardHeader" Grid.Column="0" VerticalAlignment="Bottom" Margin="16,0,16,20">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Grid.Row="1" Grid.Column="1" Margin="0,12,0,0" Padding="12" CornerRadius="12" BorderThickness="1"
                        Background="{StaticResource NoxCardHoverBrush}" BorderBrush="{StaticResource NoxBorderBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource NoxAccentMutedBrush}" VerticalAlignment="Center">
                            <Viewbox Width="16" Height="16">
                                <Path Style="{StaticResource NoxIconPath}" Data="{StaticResource NoxIconUser}" Stroke="{StaticResource NoxAccentBrush}"/>
                            </Viewbox>
                        </Border>
                        <TextBlock Grid.Column="1" x:Name="SignedInUserTextBlock" Margin="10,0,0,0" FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" x:Name="HeaderActions" Orientation="Vertical">
                    <ComboBox x:Name="DashboardLanguageBox" Style="{StaticResource SelectorStyle}" Height="44" Margin="0,0,0,4"
                              Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextMutedBrush}"
                                  SelectedValuePath="Tag" SelectionChanged="Language_Changed" AutomationProperties.Name="{DynamicResource NoxText.Language}">
                        <ComboBoxItem Tag="it" Content="Italiano"/><ComboBoxItem Tag="en" Content="English"/>
                    </ComboBox>
                    <Button x:Name="LogoutButton" Click="LogoutButton_Click" Style="{StaticResource SidebarButtonStyle}"
                            Height="44" Margin="0" AutomationProperties.Name="{DynamicResource NoxText.Logout}">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                                <Path Style="{StaticResource NoxIconPath}" Data="{StaticResource NoxIconSignOut}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Viewbox>
                            <TextBlock Text="{DynamicResource NoxText.Logout}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
    </DockPanel>
</Window>
