<Project Sdk="Microsoft.NET.Sdk">

  <!-- NOX desktop client for macOS (Apple Silicon), built with Avalonia.
       It runs on Windows too, which is how it is developed and tested from a PC. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Client.MacOS</RootNamespace>
    <AssemblyName>NOX</AssemblyName>
    <Version>3.3</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>NOX</Product>
    <ApplicationIcon>..\Client.Windows\Assets\NoxWindows.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.23" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.23" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.23" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.23" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Client.Core\Client.Core.csproj" />
    <ProjectReference Include="..\CryptoEngine\CryptoEngine.csproj" />
    <ProjectReference Include="..\Shared\Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\NoxLogo.png" />
    <AvaloniaResource Include="Assets\NoxAppIcon.png" />
    <None Include="Assets\NOX.icns" />
    <None Include="macOS\**" />
  </ItemGroup>

</Project>
