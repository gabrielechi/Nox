<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- NOX palette and vector icons: same values as Client.Windows/Themes/NoxTheme.xaml. -->
    <Color x:Key="NoxWindowColor">#0E1116</Color>
    <Color x:Key="NoxSidebarColor">#12171D</Color>
    <Color x:Key="NoxCardColor">#151A21</Color>
    <Color x:Key="NoxCardHoverColor">#1A2028</Color>
    <Color x:Key="NoxRaisedColor">#1E2630</Color>
    <Color x:Key="NoxRaisedHoverColor">#252E3A</Color>
    <Color x:Key="NoxBorderColor">#2A323D</Color>
    <Color x:Key="NoxBorderStrongColor">#3A4553</Color>
    <Color x:Key="NoxTextColor">#E8ECF2</Color>
    <Color x:Key="NoxTextMutedColor">#9AA4B2</Color>
    <Color x:Key="NoxTextDisabledColor">#5C6673</Color>
    <Color x:Key="NoxAccentColor">#4ADE9A</Color>
    <Color x:Key="NoxAccentForegroundColor">#07130D</Color>
    <Color x:Key="NoxAccentSubtleColor">#17211F</Color>
    <Color x:Key="NoxAccentMutedColor">#26453A</Color>
    <Color x:Key="NoxWarningColor">#F5B94A</Color>
    <Color x:Key="NoxDangerColor">#C42B1C</Color>
    <SolidColorBrush x:Key="NoxWindowBrush" Color="#0E1116"/>
    <SolidColorBrush x:Key="NoxSidebarBrush" Color="#12171D"/>
    <SolidColorBrush x:Key="NoxCardBrush" Color="#151A21"/>
    <SolidColorBrush x:Key="NoxCardHoverBrush" Color="#1A2028"/>
    <SolidColorBrush x:Key="NoxRaisedBrush" Color="#1E2630"/>
    <SolidColorBrush x:Key="NoxRaisedHoverBrush" Color="#252E3A"/>
    <SolidColorBrush x:Key="NoxBorderBrush" Color="#2A323D"/>
    <SolidColorBrush x:Key="NoxBorderStrongBrush" Color="#3A4553"/>
    <SolidColorBrush x:Key="NoxTextBrush" Color="#E8ECF2"/>
    <SolidColorBrush x:Key="NoxTextMutedBrush" Color="#9AA4B2"/>
    <SolidColorBrush x:Key="NoxTextDisabledBrush" Color="#5C6673"/>
    <SolidColorBrush x:Key="NoxAccentBrush" Color="#4ADE9A"/>
    <SolidColorBrush x:Key="NoxAccentForegroundBrush" Color="#07130D"/>
    <SolidColorBrush x:Key="NoxAccentSubtleBrush" Color="#17211F"/>
    <SolidColorBrush x:Key="NoxAccentMutedBrush" Color="#26453A"/>
    <SolidColorBrush x:Key="NoxWarningBrush" Color="#F5B94A"/>
    <SolidColorBrush x:Key="NoxDangerBrush" Color="#C42B1C"/>
    <SolidColorBrush x:Key="NoxSelectionBrush" Color="#4ADE9A" Opacity="0.35"/>
    <SolidColorBrush x:Key="NoxPrimaryHoverBrush" Color="#6BE8AE"/>
    <SolidColorBrush x:Key="NoxPrimaryPressedBrush" Color="#3BC587"/>

    <FontFamily x:Key="NoxFontFamily">fonts:Inter#Inter, $Default</FontFamily>
    <FontFamily x:Key="NoxMonoFontFamily">Menlo, Consolas, monospace</FontFamily>

    <!-- Fluent theme accent, mapped to the NOX mint. -->
    <Color x:Key="SystemAccentColor">#4ADE9A</Color>
    <Color x:Key="SystemAccentColorDark1">#3BC587</Color>
    <Color x:Key="SystemAccentColorDark2">#2FA772</Color>
    <Color x:Key="SystemAccentColorDark3">#24885D</Color>
    <Color x:Key="SystemAccentColorLight1">#6BE8AE</Color>
    <Color x:Key="SystemAccentColorLight2">#8DEFC2</Color>
    <Color x:Key="SystemAccentColorLight3">#B1F5D6</Color>
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#07130D"/>
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#07130D"/>
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#07130D"/>
    <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#4ADE9A" Opacity="0.35"/>
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#1E2630"/>
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#3A4553"/>
    <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#252E3A"/>
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#26453A"/>
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#26453A"/>

