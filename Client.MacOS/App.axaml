<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Client.MacOS.App"
             Name="NOX"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://NOX/Themes/NoxResources.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme/>
        <StyleInclude Source="avares://NOX/Themes/NoxStyles.axaml"/>
    </Application.Styles>
    <!-- Replaces the default "About Avalonia" entry of the macOS application menu. -->
    <NativeMenu.Menu>
        <NativeMenu/>
    </NativeMenu.Menu>
</Application>
