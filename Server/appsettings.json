// ============================================================================
//  NOX Server - configuration
//  This is the only file to edit: it sits next to the server executable.
//  Lines starting with // are comments. Restart the server after a change.
//  Every value can also be set with an environment variable,
//  for example Server__HttpPort=8080 (two underscores between section and name).
// ============================================================================
{
  // Language of the messages shown by the server on screen and in its log:
  //   "EN" = English (default)
  //   "IT" = Italian
  "Language": "EN",

  "Server": {
    // Address to listen on:
    //   "0.0.0.0"   = every network adapter: reachable from the other computers on your network
    //   "127.0.0.1" = this computer only
    //   a specific IP (e.g. "192.168.1.20") = that network adapter only
    "ListenAddress": "0.0.0.0",

    // HTTP port. In the NOX client choose HTTP and type server-IP:port (e.g. 192.168.1.20:5000).
    // 0 = HTTP off (then HTTPS below is required).
    "HttpPort": 5000,

    // Optional HTTPS: port and certificate in .pfx format (absolute path or next to the server).
    // 0 = HTTPS off.
    "HttpsPort": 0,
    "CertificatePath": "",
    "CertificatePassword": "",

    // Data folder: database, encrypted files waiting to be downloaded, sign-in token key and logs.
    // Empty = "data" folder next to the server. Back up this folder.
    "DataDirectory": ""
  },

  "Transfers": {
    // Maximum size of a single encrypted file, in bytes (10737418240 = 10 GB).
    "MaximumCiphertextLength": 10737418240
  },

  "Security": {
    // Sign-in attempts per minute per IP address (beyond that: "too many requests").
    "LoginAttemptsPerMinute": 5,
    // Username checks per minute per IP address.
    "UsernameChecksPerMinute": 10
  },

  "Jwt": {
    // How long a sign-in lasts, in minutes: after that the client asks to sign in again.
    "ExpirationMinutes": 60,
    // Secret key of the sign-in tokens. Leave it empty: it is generated on first start and
    // saved in data/jwt-secret.key. If you change it, everyone has to sign in again.
    "SecretKey": ""
  },

  "Log": {
    // Copy of the log in data/logs/nox-YYYY-MM-DD.log (one file per day).
    "ToFile": true,
    // Days of log files to keep: older files are deleted automatically. 0 = keep them all.
    "RetentionDays": 30,
    // Show also the incoming-files check that every client makes every 5 seconds.
    // false (default) = hidden, because it would flood the screen; failed checks are shown anyway.
    "ShowInboxPolling": false
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
